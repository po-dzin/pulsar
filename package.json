{
  "name": "pulsar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_DEV_ENGINE=turbo next dev --turbopack",
    "dev:webpack": "NEXT_DEV_ENGINE=webpack next dev",
    "dev:clean": "rm -rf .next .next-dev-turbo .next-dev-webpack && NEXT_DEV_ENGINE=turbo next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "vitest run tests/contracts/admin-api.perf.spec.ts",
    "test:stress": "vitest run tests/contracts/admin-api.stress.spec.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --workers=1",
    "test:e2e:core": "playwright test tests/e2e/navigation-ui.spec.ts tests/e2e/diagnostics-psychosomatic.spec.ts tests/e2e/diagnostics-physical.spec.ts tests/e2e/products-knowledge.spec.ts --workers=1",
    "test:e2e:auth:user": "playwright test tests/e2e/auth-user-smoke.spec.ts --workers=1 --project=chromium-desktop",
    "test:e2e:auth:admin": "playwright test tests/e2e/admin-content-crud.spec.ts --workers=1 --project=chromium-desktop",
    "test:e2e:auth": "playwright test tests/e2e/auth-user-smoke.spec.ts tests/e2e/admin-content-crud.spec.ts --workers=1 --project=chromium-desktop",
    "e2e:auth:record:user": "node scripts/e2e-record-auth.mjs tests/e2e/.auth/user.json",
    "e2e:auth:record:admin": "node scripts/e2e-record-auth.mjs tests/e2e/.auth/admin.json",
    "e2e:auth:state:user": "node scripts/e2e-write-storage-state.mjs tests/e2e/.auth/user.json E2E_STORAGE_STATE_USER",
    "e2e:auth:state:admin": "node scripts/e2e-write-storage-state.mjs tests/e2e/.auth/admin.json E2E_STORAGE_STATE_ADMIN",
    "ci:smoke": "npm run typecheck && npm run lint && npm run test && npm run test:e2e:smoke"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "fast-check": "^4.5.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
